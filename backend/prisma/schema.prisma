generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     Int                             @id @default(autoincrement())
  nome                   String
  email                  String                          @unique
  senha                  String
  role                   Role                            @default(ADMIN)
  ativo                  Boolean                         @default(true)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  refreshTokens          RefreshToken[]
  conciliacoesResolvidas PagamentoConciliacao[]          @relation("ConciliacaoResolvidaPor")
  conciliacaoHistorico   PagamentoConciliacaoHistorico[]

  @@map("usuarios")
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  slug      String    @unique
  descricao String?
  imagem    String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  produtos  Produto[]

  @@map("categorias")
}

model Produto {
  id               Int                @id @default(autoincrement())
  nome             String
  slug             String             @unique
  descricao        String?
  preco            Decimal            @db.Decimal(10, 2)
  precoPromocional Decimal?           @db.Decimal(10, 2)
  estoque          Int                @default(0)
  sku              String?            @unique
  imagemPrincipal  String?
  imagens          String[]           @default([])
  destaque         Boolean            @default(false)
  ativo            Boolean            @default(true)
  categoriaId      Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  movimentos       EstoqueMovimento[]
  itensPedido      ItensPedido[]
  categoria        Categoria          @relation(fields: [categoriaId], references: [id])

  @@map("produtos")
}

model Cliente {
  id                  Int                  @id @default(autoincrement())
  nome                String
  email               String?              @unique
  telefone            String
  cpf                 String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  senha               String?
  googleId            String?              @unique
  emailVerificado     Boolean              @default(false)
  resetTokenExpiry    DateTime?
  resetTokenHash      String?
  verifyTokenHash     String?
  verifyTokenExpiry   DateTime?
  agendamentos        Agendamento[]
  clientRefreshTokens ClientRefreshToken[]
  pedidos             Pedido[]

  @@map("clientes")
}

model Agendamento {
  id              Int               @id @default(autoincrement())
  clienteId       Int?
  nomeContato     String
  telefoneContato String?
  email           String?
  whatsapp        String
  endereco        String?
  cep             String?
  cidade          String?
  equipamento     String
  marca           String?
  modelo          String?
  problema        String
  observacoes     String?
  melhorHorario   String?
  dataAgendamento DateTime?
  status          StatusAgendamento @default(PENDENTE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  cliente         Cliente?          @relation(fields: [clienteId], references: [id])

  @@map("agendamentos")
}

model Pedido {
  id                   Int                    @id @default(autoincrement())
  clienteId            Int
  valorTotal           Decimal                @db.Decimal(10, 2)
  status               StatusPedido           @default(PENDENTE)
  observacoes          String?
  paymentStatus        String?
  paymentMethod        String?
  paymentId            String?
  preferenceId         String?
  externalReference    String?
  paidAt               DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  nomeDestinatario     String?
  telefoneEntrega      String?
  cep                  String?
  rua                  String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  estado               String?
  stockLedgerVersion   Int?
  creationKey          String?
  creationHash         String?
  checkoutInitPoint    String?
  movimentos           EstoqueMovimento[]
  conciliacoes         PagamentoConciliacao[]
  checkoutAccessTokens CheckoutAccessToken[]
  itens                ItensPedido[]
  cliente              Cliente                @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, creationKey])
  @@map("pedidos")
}

model CheckoutAccessToken {
  id        Int       @id @default(autoincrement())
  pedidoId  Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  pedido    Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([expiresAt])
  @@map("checkout_access_tokens")
}

model MercadoPagoWebhookEvent {
  id                 Int       @id @default(autoincrement())
  provider           String    @default("mercadopago")
  notificationId     String?
  paymentId          String?
  signatureHash      String?
  signatureTimestamp BigInt?
  rawPayloadHash     String
  processed          Boolean   @default(false)
  processedAt        DateTime?
  firstSeenAt        DateTime  @default(now())
  updatedAt          DateTime

  @@unique([provider, notificationId])
  @@index([paymentId])
  @@index([provider, processed])
  @@map("mercado_pago_webhook_events")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  usuarioId Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model ItensPedido {
  id            Int                @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int
  quantidade    Int
  movimentos    EstoqueMovimento[]
  precoUnitario Decimal            @db.Decimal(10, 2)
  pedido        Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto            @relation(fields: [produtoId], references: [id])

  @@map("itens_pedido")
}

model ClientRefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  clienteId Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  clientes  Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("client_refresh_tokens")
}

enum Role {
  ADMIN
  TECNICO
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusPedido {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
  PREPARANDO
}

// CHECKs, immutable rows, stock application and deferred completeness are SQL migration rules.
model EstoqueMovimento {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId       Int
  itemId         Int
  produtoId      Int
  tipo           String
  quantidade     Int
  origem         String
  debitoOrigemId String?           @unique @db.Uuid
  createdAt      DateTime          @default(now())
  pedido         Pedido            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  item           ItensPedido       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  produto        Produto           @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  debitoOrigem   EstoqueMovimento? @relation("Compensacao", fields: [debitoOrigemId], references: [id], onDelete: Restrict)
  devolucao      EstoqueMovimento? @relation("Compensacao")

  @@unique([itemId, tipo])
  @@index([pedidoId])
  @@map("estoque_movimentos")
}

// Fila persistente e auditável de pendências financeiras para conciliação MANUAL.
// Nunca dispara reembolso. Guarda apenas identificadores, status, valores e hash do payload.
model PagamentoConciliacao {
  id                  Int                             @id @default(autoincrement())
  provider            String                          @default("mercadopago")
  chaveIdempotencia   String
  tipo                String
  verificacao         String
  status              String                          @default("PENDENTE")
  pedidoId            Int?
  paymentId           String?
  paymentIdInformado  String?
  notificationId      String?
  rawPayloadHash      String
  referenciaExterna   String?
  statusProvedor      String?
  statusPedido        String?
  valorProvedor       Decimal?                        @db.Decimal(10, 2)
  valorPedido         Decimal?                        @db.Decimal(10, 2)
  preferenciaProvedor String?
  preferenciaPedido   String?
  ocorrencias         Int                             @default(1)
  primeiraVezEm       DateTime                        @default(now())
  ultimaVezEm         DateTime                        @default(now())
  resolvidoEm         DateTime?
  resolvidoPorId      Int?
  observacao          String?
  updatedAt           DateTime
  pedido              Pedido?                         @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  resolvidoPor        Usuario?                        @relation("ConciliacaoResolvidaPor", fields: [resolvidoPorId], references: [id], onDelete: Restrict)
  historico           PagamentoConciliacaoHistorico[]

  @@unique([provider, chaveIdempotencia, tipo])
  @@index([status, tipo])
  @@index([pedidoId])
  @@index([paymentId])
  @@map("pagamento_conciliacoes")
}

// Append-only: triggers impedem UPDATE/DELETE.
model PagamentoConciliacaoHistorico {
  id             Int                  @id @default(autoincrement())
  conciliacaoId  Int
  acao           String
  statusAnterior String?
  statusNovo     String?
  usuarioId      Int?
  observacao     String?
  notificationId String?
  createdAt      DateTime             @default(now())
  conciliacao    PagamentoConciliacao @relation(fields: [conciliacaoId], references: [id], onDelete: Restrict)
  usuario        Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([conciliacaoId, createdAt])
  @@map("pagamento_conciliacao_historico")
}
