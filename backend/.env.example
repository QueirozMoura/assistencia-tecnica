# ==============================
# APP
# ==============================
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Preencher com hostname exato do projeto vazio de desenvolvimento.
DEV_DATABASE_HOST=
EMAIL_TRANSPORT=mock
TELEGRAM_TRANSPORT=mock
UPLOAD_DRIVER=local
# Criados por npm run db:setup:local; valores reais ficam somente no .env ignorado.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# ==============================
# DATABASE
# ==============================
# Preencher SOMENTE com banco de desenvolvimento confirmado, sem dados de clientes.
DATABASE_URL=
# DIRECT_URL e lida na validacao de startup, mas NAO e usada no schema atual.
# Nao substitui DATABASE_URL e nao configura a conexao das migracoes.
DIRECT_URL=

# ==============================
# AUTH (ADMIN)
# ==============================
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ==============================
# AUTH (CLIENT)
# ==============================
JWT_CLIENT_SECRET=
JWT_CLIENT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=7
CHECKOUT_TOKEN_TTL_MINUTES=15

# ==============================
# GOOGLE OAUTH
# ==============================
GOOGLE_CLIENT_ID=
# O frontend atual envia idToken; estas duas variaveis sao do fluxo legado por code.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==============================
# EMAIL (RESEND)
# ==============================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_URL=http://localhost:5173
ADMIN_NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================
# CORS
# ==============================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ==============================
# LOGS
# ==============================
LOG_LEVEL=info

# ==============================
# CLOUDINARY
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# MERCADO PAGO
# ==============================
# Checkout Pro: credencial exclusiva da conta vendedora de teste, inclusive APP_USR.
# O backend confirma /users/me (ID e tag test_user) antes de criar preferências.
MERCADO_PAGO_MODE=test
MERCADO_PAGO_TEST_SELLER_ID=
MERCADO_PAGO_ALLOW_PUBLIC_WEBHOOK=false
MERCADO_PAGO_ACCESS_TOKEN=
# Alias usado apenas por config/mercadopago.js; pagamentos usam o nome acima.
MP_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Webhooks requerem URL HTTPS publica de desenvolvimento, nunca a de producao.
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_SUCCESS_URL=http://localhost:5173/pagamento/sucesso
MERCADO_PAGO_FAILURE_URL=http://localhost:5173/checkout
MERCADO_PAGO_PENDING_URL=http://localhost:5173/checkout/pendente
